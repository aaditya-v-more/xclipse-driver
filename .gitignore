# Big or re-creatable things stay out of git.
# third_party/MANIFEST.md lists how to re-clone the reference repos; tools/README.md lists the toolchain.
/third_party/*
!/third_party/MANIFEST.md
/tools/*
!/tools/env.cmd
!/tools/README.md
!/tools/setup.ps1
!/tools/env.sh
!/tools/setup.sh
*.zip
*.nupkg
/driver/build-log.txt
/tests/build/
__pycache__/
# Of each run only the summary and the data stay in git; screenshots and logs stay on the computer
# that made them (user decision, 2026-10-11).
/results/*/*
!/results/*/summary.md
!/results/*/results.json
