# Big or re-creatable things stay out of git.
# Named reference submodules are pinned in Git; other checkouts and portable tools stay local.
/third_party/*
!/third_party/MANIFEST.md
!/third_party/gamenative
!/third_party/gamenative-release.json
!/third_party/ExynosTools
!/third_party/Xclipse940-RADV
!/third_party/dxvk
!/third_party/gamenative-mesa
!/third_party/kernel-r12s
!/third_party/mesa-unified-drivers
!/third_party/mesa-upstream
!/third_party/radv-xclipse
!/third_party/radv-xclipse940
/tools/*
!/tools/env.cmd
!/tools/README.md
!/tools/setup.ps1
!/tools/env.sh
!/tools/setup.sh
*.zip
*.nupkg
/driver/build-log.txt
/tests/build/
__pycache__/
# Of each run only the summary and the data stay in git; screenshots and logs stay on the computer
# that made them (user decision, 2026-10-11).
/results/*/*
!/results/*/summary.md
!/results/*/results.json
.DS_Store
