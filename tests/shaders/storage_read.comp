#version 450
// Reads a storage-written image back through a sampler, 16x16 texels of every level, after the
// layout transitions GameNative's BCn layer and DXVK put it through (general, transfer, shader
// read). The host checks the texels against what the storage writes should have left.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D tex;
layout(std430, binding = 1) writeonly buffer Out { vec4 o[]; };
layout(push_constant) uniform P { int levels; };
void main()
{
   ivec2 g = ivec2(gl_LocalInvocationID.xy);
   for (int level = 0; level < levels; level++) {
      ivec2 size = textureSize(tex, level);
      ivec2 n = min(size, ivec2(16));
      if (any(greaterThanEqual(g, n)))
         continue;
      ivec2 t = g * size / n + size / n / 2;
      o[level * 256 + g.y * 16 + g.x] = texelFetch(tex, t, level);
   }
}
