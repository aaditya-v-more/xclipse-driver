#version 450
// Cross-lane operations whose partner lane can sit in the other half of a wave64. Each invocation
// writes its lane coordinates and five results; the host recomputes them from the coordinates.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { uint data[]; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   uint lane = gl_SubgroupInvocationID, size = gl_SubgroupSize;
   uint v = i * 2654435761u + 12345u;
   uint o = i * 8u;
   data[o + 0u] = (gl_WorkGroupID.x << 16) | (gl_SubgroupID << 8) | lane;
   data[o + 1u] = size;
   data[o + 2u] = subgroupShuffle(v, (lane + size / 2u) % size);  // other half, variable index
   data[o + 3u] = subgroupShuffle(v, size - 1u - lane);            // reversed
   data[o + 4u] = subgroupShuffleXor(v, size / 2u);               // constant other half
   data[o + 5u] = subgroupShuffleDown(v, 1u);                     // crosses at lane 31
   data[o + 6u] = subgroupAdd(v);
   data[o + 7u] = subgroupInclusiveAdd(v);
}
