#version 450
// Reads a mipmapped texture back at a grid of up to 16x16 texels of every level and layer: exactly
// (texelFetch), through a nearest sampler at that level (textureLod), through the same sampler with
// gradients that select that level (textureGrad, seven address operands, so GFX11 encodes it as a
// partial NSA), and for a cube map by the direction that points at the texel. The host checks all
// four against the data it uploaded.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2DArray tex;
layout(binding = 1) uniform samplerCube cube;
layout(std430, binding = 2) writeonly buffer Out { vec4 o[]; };
layout(push_constant) uniform P { int levels; int layers; int is_cube; };
void main()
{
   ivec2 g = ivec2(gl_LocalInvocationID.xy);
   for (int layer = 0; layer < layers; layer++) {
      for (int level = 0; level < levels; level++) {
         ivec2 size = textureSize(tex, level).xy;
         ivec2 n = min(size, ivec2(16));
         if (any(greaterThanEqual(g, n)))
            continue;
         ivec2 t = g * size / n + size / n / 2;
         int i = ((layer * levels + level) * 256 + g.y * 16 + g.x) * 4;
         vec2 uv = (vec2(t) + 0.5) / vec2(size);
         o[i] = texelFetch(tex, ivec3(t, layer), level);
         o[i + 1] = textureLod(tex, vec3(uv, layer), float(level));
         vec2 step = exp2(float(level)) / vec2(textureSize(tex, 0).xy);
         o[i + 2] = textureGrad(tex, vec3(uv, layer), vec2(step.x, 0.0), vec2(0.0, step.y));
         if (is_cube != 0) {
            vec2 st = uv * 2.0 - 1.0;
            vec3 dirs[6] = vec3[](vec3(1.0, -st.y, -st.x), vec3(-1.0, -st.y, st.x),
                                  vec3(st.x, 1.0, st.y), vec3(st.x, -1.0, -st.y),
                                  vec3(st.x, -st.y, 1.0), vec3(-st.x, -st.y, -1.0));
            o[i + 3] = textureLod(cube, dirs[layer], float(level));
         }
      }
   }
}
