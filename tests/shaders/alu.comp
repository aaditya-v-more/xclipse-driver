#version 450
// FP32 throughput: four independent FMA chains per invocation, 64 FLOPs per loop iteration.
// Every component of every chain starts from a different value and uses its own runtime
// multiplier and addend. Anything less lets a compiler share work: with identical constants AMD's
// shader compiler folds the four chains into one, and with identical components it computes one
// lane and copies it.
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Out { vec4 result[]; };
layout(push_constant) uniform Push
{
   uint iterations;
   float seed;
   vec4 m;
   vec4 k;
} pc;

void main()
{
   uint i = gl_GlobalInvocationID.x;
   float f = pc.seed + float(i & 7u);
   vec4 a = vec4(f, f + 0.1, f + 0.2, f + 0.3);
   vec4 b = a.yzwx + 1.0, c = a.zwxy + 2.0, d = a.wxyz + 3.0;
   vec4 ma = pc.m, mb = pc.m.yzwx, mc = pc.m.zwxy, md = pc.m.wxyz;
   vec4 ka = pc.k, kb = pc.k.wzyx, kc = pc.k.yxwz, kd = pc.k.zwyx;
   for (uint n = 0u; n < pc.iterations; n++) {
      a = fma(a, ma, ka); b = fma(b, mb, kb); c = fma(c, mc, kc); d = fma(d, md, kd);
      a = fma(a, ma, ka); b = fma(b, mb, kb); c = fma(c, mc, kc); d = fma(d, md, kd);
   }
   result[i] = a + b + c + d;
}
